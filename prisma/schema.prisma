// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("EMPLOYEE")
  department    String?
  title         String?
  phone         String?
  location      String?
  bio           String?
  startDate     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  ticketsRequested Ticket[] @relation("TicketRequester")
  ticketsAssigned  Ticket[] @relation("TicketAssignee")
  
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String   @default("general")
  priority  String   @default("NORMAL")
  authorId  String
  pinned    Boolean  @default(false)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  category    String   @default("general")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

model QuickLink {
  id          String   @id @default(cuid())
  title       String
  url         String
  description String?
  icon        String?
  category    String   @default("general")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("quick_links")
}

model HrResource {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String?
  category    String
  fileType    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("hr_resources")
}

// ─── Help desk ───────────────────────────────────────────
model Ticket {
  id              String    @id @default(cuid())
  number          Int       @unique            // shown as MCC-<number>
  subject         String
  description     String
  category        String    @default("Other")
  priority        String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status          String    @default("OPEN")   // OPEN | IN_PROGRESS | WAITING | RESOLVED | CLOSED
  source          String    @default("PORTAL") // PORTAL | EMAIL
  requesterId     String?
  requesterEmail  String
  requesterName   String?
  assigneeId      String?
  sourceMessageId String?   @unique            // Internet-Message-ID of the originating email (dedupe)
  accessToken     String?                      // unguessable (192-bit random) token for the no-login ticket link (/t/<token>); plain index, not unique, so `db push` needs no --accept-data-loss
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  resolvedAt      DateTime?
  lastActivityAt  DateTime  @default(now())

  requester User?           @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  assignee  User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments  TicketComment[]
  attachments TicketAttachment[]
  approvals   TicketApproval[]

  @@index([status])
  @@index([requesterEmail])
  @@index([accessToken])
  @@map("tickets")
}

model TicketComment {
  id          String   @id @default(cuid())
  ticketId    String
  authorId    String?
  authorName  String?
  authorEmail String?
  body        String
  isInternal  Boolean  @default(false)
  source      String   @default("PORTAL") // PORTAL | EMAIL | SYSTEM
  messageId   String?  @unique            // Internet-Message-ID when imported from email
  createdAt   DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_comments")
}

model MailSyncState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("mail_sync_state")
}

// Files live on disk (<data volume>/attachments/<id>); only metadata is stored here.
model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  commentId    String?  // null = attached to the original request
  filename     String
  mimeType     String
  size         Int
  previewable  Boolean  @default(false) // verified image/PDF (by file signature) -> safe to show inline
  uploadedById String?
  source       String   @default("PORTAL") // PORTAL | EMAIL
  createdAt    DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_attachments")
}

// Approval requests sent to a person (director etc.). The emailed link carries a random token; only its hash is stored.
model TicketApproval {
  id              String    @id @default(cuid())
  ticketId        String
  approverEmail   String
  approverName    String?
  approverUserId  String?
  requestedById   String?
  requestedByName String?
  note            String?   // message from IT shown to the approver
  status          String    @default("PENDING") // PENDING | APPROVED | DECLINED | CANCELLED
  tokenHash       String    @unique
  decisionComment String?
  decidedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_approvals")
}
