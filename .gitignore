prisma/*.db
prisma/*.db-journal
/data/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# local ticket attachments
prisma/attachments/
