# ─────────────────────────────────────────────────────────
# MCC Employee Portal — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────

# Database (SQLite — path is relative to project root)
DATABASE_URL="file:./prisma/dev.db"

# NextAuth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_32_CHARS"
NEXTAUTH_URL="http://localhost:3000"

# ─── Okta SSO (uncomment when ready) ──────────────────────
# AUTH_OKTA_ID="YOUR_OKTA_CLIENT_ID"
# AUTH_OKTA_SECRET="YOUR_OKTA_CLIENT_SECRET"
# AUTH_OKTA_ISSUER="https://YOUR_DOMAIN.okta.com/oauth2/default"
# ──────────────────────────────────────────────────────────

# ─── SharePoint (optional — for embedded docs) ────────────
# SHAREPOINT_TENANT_ID="YOUR_AZURE_TENANT_ID"
# SHAREPOINT_CLIENT_ID="YOUR_AZURE_APP_CLIENT_ID"
# SHAREPOINT_CLIENT_SECRET="YOUR_AZURE_APP_SECRET"
# SHAREPOINT_SITE_URL="https://YOUR_TENANT.sharepoint.com/sites/Intranet"
# ──────────────────────────────────────────────────────────

# ─── Production only ──────────────────────────────────────
# DATABASE_URL="file:/data/portal.db"
# NEXTAUTH_URL="https://portal.mccollege.edu"
# ──────────────────────────────────────────────────────────
